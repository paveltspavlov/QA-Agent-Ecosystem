# ============================================================================
# TEST CONFIGURATION - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and update values as needed
# ============================================================================

# ============================================================================
# BASE URLS
# ============================================================================

# Base URL for UI tests (target website)
BASE_URL=https://example.com

# Base URL for API tests (if applicable)
API_BASE_URL=https://example.com/api

# ============================================================================
# BROWSER CONFIGURATION
# ============================================================================

# Run in headless mode (true) or headed mode (false for debugging)
HEADLESS=true

# Browser type: chromium, firefox, webkit (for manual runs)
BROWSER=chromium

# ============================================================================
# TIMEOUTS (milliseconds)
# ============================================================================

# Global test timeout
TEST_TIMEOUT=30000

# Navigation timeout
NAVIGATION_TIMEOUT=15000

# Short waits for quick interactions
TIMEOUT_SHORT=3000

# Medium waits for standard operations
TIMEOUT_MEDIUM=5000

# Long waits for slow operations
TIMEOUT_LONG=10000

# ============================================================================
# AUTHENTICATION
# ============================================================================

# Test user credentials (from task: username: testuser, password: Test@1234)
TEST_USER_EMAIL=testuser
TEST_USER_PASSWORD=Test@1234

# Additional test credentials for role-based testing
TEST_ADMIN_EMAIL=admin
TEST_ADMIN_PASSWORD=Admin@1234

TEST_GUEST_EMAIL=guest
TEST_GUEST_PASSWORD=Guest@1234

# ============================================================================
# CI/CD ENVIRONMENT
# ============================================================================

# Auto-set by most CI platforms (GitHub Actions, GitLab CI, etc.)
# Set to true to enable CI-specific behavior (stricter retries, parallel workers, etc.)
# CI=true

# ============================================================================
# TEST FILTERING & EXECUTION
# ============================================================================

# Run only tests matching this tag (@smoke, @regression, @ui, etc.)
# Leave empty to run all tests
# TEST_TAG=@smoke

# Number of workers for parallel test execution
# Leave unset for automatic (workers = CPU cores)
# WORKERS=4

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Capture full page screenshots on failure (default behavior)
SCREENSHOT_ON_FAILURE=true

# Capture video on failure
VIDEO_ON_FAILURE=true

# Trace mode: 'on', 'off', 'on-first-retry', 'retain-on-failure'
TRACE_MODE=on-first-retry

# ============================================================================
# TEST DATA SEEDING
# ============================================================================

# API base URL for seeding test data (can differ from BASE_URL)
# SEEDING_API_BASE_URL=https://api.example.com

# Run ID for batch cleanup (auto-generated if not set)
# RUN_ID=test-run-2024-04-06

# Number of resources to seed
SEED_USERS_COUNT=3
SEED_PRODUCTS_COUNT=5
SEED_BOOKS_COUNT=3

# ============================================================================
# PROXY & NETWORK (if needed)
# ============================================================================

# HTTP proxy for requests
# HTTP_PROXY=http://proxy.example.com:8080

# HTTPS proxy for requests
# HTTPS_PROXY=https://proxy.example.com:8443

# ============================================================================
# CUSTOM FLAGS
# ============================================================================

# Enable detailed logging
DEBUG=false

# Skip auth setup (use cached state)
SKIP_AUTH_SETUP=false

# Fail fast on first test failure
FAIL_FAST=false

