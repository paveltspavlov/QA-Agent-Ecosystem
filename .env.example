# QA Agent Ecosystem — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit your real .env file to version control.

# GitHub Copilot (recommended — run `gh auth login` instead of setting this manually)
GITHUB_TOKEN=your_github_token_here

# Anthropic API (for anthropic-api and claude providers)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (for openai provider)
OPENAI_API_KEY=sk-...

# Together AI (optional)
TOGETHER_API_KEY=

# Groq (optional)
GROQ_API_KEY=

# Custom models.yaml path (optional — defaults to qa_ecosystem/models.yaml)
QA_MODELS_CONFIG=
